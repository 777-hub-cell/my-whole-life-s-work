# Aharane has its own environment and must not read MSCC settings.
AHARANE_HOST=127.0.0.1
AHARANE_PORT=8790
AHARANE_DATA_DIR=/var/lib/aharane

# The installer replaces this placeholder with a unique random token.
# Read the generated value from /etc/aharane.env on the server.
AHARANE_ADMIN_TOKEN=GENERATE_ON_INSTALL

# Distinct owner identities. The Private Owner number must match the private
# WhatsApp account paired in Local Studio. The Public Owner is checked only
# for public commands marked ownerOnly.
AHARANE_PRIVATE_OWNER_NUMBER=
AHARANE_PUBLIC_OWNER_NUMBER=

# Optional comma-separated direct-message senders allowed to use public
# commands. The Public Owner is added automatically. Groups remain disabled.
AHARANE_ALLOWED_PUBLIC_SENDERS=

# Legacy migration aliases are still read if the new public settings are empty:
# AHARANE_OWNER_NUMBER -> AHARANE_PUBLIC_OWNER_NUMBER
# AHARANE_ALLOWED_SENDERS -> AHARANE_ALLOWED_PUBLIC_SENDERS

LOG_LEVEL=info
