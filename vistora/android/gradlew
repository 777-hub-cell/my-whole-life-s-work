#!/usr/bin/env sh
set -eu
APP_HOME="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
WORKSPACE_WRAPPER="$APP_HOME/../../aharane/android/gradlew"
if [ ! -x "$WORKSPACE_WRAPPER" ]; then
    echo "VISTORA uses the checked-in workspace Gradle wrapper at aharane/android/gradlew." >&2
    echo "Run this project from a full checkout of the repository." >&2
    exit 1
fi
exec "$WORKSPACE_WRAPPER" -p "$APP_HOME" "$@"
