# Include this location block in the HTTPS server block for the separate
# NIGHT Control Centre website. Replace the upstream with the bot server's
# private-network address and the existing MSCC WEB_PORT.
#
# Do not expose the MSCC admin listener to the public internet. Permit the
# website server to reach it over a private network or authenticated tunnel,
# and restrict the bot-server firewall to this website server.

location ^~ /api/control-centre/ {
    # No URI suffix: preserve /api/control-centre/... for the MSCC router.
    proxy_pass http://YOUR_PRIVATE_BOT_HOST:YOUR_MSCC_WEB_PORT;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
    proxy_buffering off;
}
