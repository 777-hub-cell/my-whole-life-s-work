# Aharane has its own environment and must not read MSCC settings.
AHARANE_HOST=127.0.0.1
AHARANE_PORT=8790
AHARANE_DATA_DIR=/var/lib/aharane

# The installer replaces this placeholder with a unique random token.
# Read the generated value from /etc/aharane.env on the server.
AHARANE_ADMIN_TOKEN=GENERATE_ON_INSTALL

# Allow only these WhatsApp DM senders (international digits, comma-separated).
# Keep empty to deny all inbound messages until you configure an allowlist.
AHARANE_OWNER_NUMBER=
AHARANE_ALLOWED_SENDERS=

# Groups are deliberately disabled in this first isolated runtime.
LOG_LEVEL=info
