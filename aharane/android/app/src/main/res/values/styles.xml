<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aharane" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#0E7A5C</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- Brand-first, platform-native splash. Never hold it for network checks. -->
    <style name="Theme.Aharane.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F2F4F3</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_aharane_mark_classic</item>
        <item name="postSplashScreenTheme">@style/Theme.Aharane</item>
    </style>
</resources>
