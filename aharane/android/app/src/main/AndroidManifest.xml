<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application android:allowBackup="false"
        android:label="Aharane"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aharane"
        android:usesCleartextTraffic="false">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <service
            android:name=".core.notifications.AharaneNotificationJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />
        <activity android:name=".MainActivity" android:exported="true"
            android:theme="@style/Theme.Aharane.Starting"
            android:windowSoftInputMode="adjustResize" />
        <activity-alias
            android:name=".LauncherClassic"
            android:targetActivity=".MainActivity"
            android:label="Aharane"
            android:icon="@mipmap/ic_aharane_classic"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherMono"
            android:targetActivity=".MainActivity"
            android:label="Aharane"
            android:icon="@mipmap/ic_aharane_mono"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherNight"
            android:targetActivity=".MainActivity"
            android:label="Aharane"
            android:icon="@mipmap/ic_aharane_night"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
